# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/follope"

# Used to sign access tokens (JWTs). Generate with: openssl rand -base64 48
# Must be at least 32 characters — see src/lib/auth.ts.
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# Port the Express server listens on
PORT=3000

# Comma-separated list of origins allowed to call the API (CORS).
# e.g. "https://follope.com,http://localhost:8081" for the Expo dev server.
ALLOWED_ORIGINS="http://localhost:8081"

# Set to true only when production traffic reaches this app through one
# trusted reverse-proxy hop. Leave unset for local development.
# TRUST_PROXY=true

# Used to build public invoice/share links, e.g. https://follope.com/invoice/:token.
# For Expo Go on your local Wi-Fi, use: exp://YOUR_COMPUTER_LAN_IP:8081/--
# PUBLIC_APP_URL="https://follope.com"

# --- Not yet wired up in code, reserved for future phases (see ARCHITECTURE.md) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# STORAGE_ENDPOINT=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# SENTRY_DSN=
