# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/follope"

# Used to sign access tokens (JWTs). Generate with: openssl rand -base64 48
# Must be at least 32 characters — see src/lib/auth.ts.
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# Port the Express server listens on
PORT=3000

# Comma-separated list of origins allowed to call the API (CORS).
# e.g. "https://follope.com,http://localhost:8081" for the Expo dev server.
ALLOWED_ORIGINS="http://localhost:8081"

# Set to true only when production traffic reaches this app through one
# trusted reverse-proxy hop. Leave unset for local development.
# TRUST_PROXY=true

# Used to build public invoice/share links, e.g. https://follope.com/invoice/:token.
# For Expo Go on your local Wi-Fi, use: exp://YOUR_COMPUTER_LAN_IP:8081/--
# PUBLIC_APP_URL="https://follope.com"

# GMAIL_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
# GMAIL_CLIENT_SECRET="your-google-oauth-client-secret"
# GMAIL_REFRESH_TOKEN="your-refresh-token"
# GMAIL_USER="follope.official@gmail.com"

# Razorpay Payment Gateway (for Automated Pro Subscriptions)
# RAZORPAY_KEY_ID="rzp_test_your_key_id"
# RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
# RAZORPAY_WEBHOOK_SECRET="follope_rzp_webhook_2026"
# STORAGE_ENDPOINT=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# SENTRY_DSN=
